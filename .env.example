# ============================================================
# 研思智境 / 舞安智护 环境变量示例
# 复制为 .env 后按需修改。占位值请勿提交真实密钥。
# ============================================================

# ---------- 基础 ----------
PORT=8787
HOST=127.0.0.1
YANZHI_DATA_DIR=./data

# ---------- 安全 ----------
# 32 字节主密钥，用于加密模型 API Key。留空则首次启动在数据目录自动生成
# master.key（权限 0600）。生产环境建议显式设置，否则数据卷丢失后已存的
# API Key 将无法解密。
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
YANZHI_MASTER_KEY=

# HTTPS 部署时设为 1（本地 http 调试保持 0，否则浏览器不会回传 Cookie）
YANZHI_SECURE_COOKIE=0

# 仅用于脚本创建管理员时的非交互输入；创建完请删除本行
YANZHI_ADMIN_PASSWORD=

# 允许模型 base_url 使用 http://localhost（仅本地调试/测试用）
YANZHI_ALLOW_HTTP_LOCAL=0

# ---------- 品牌（可选）----------
# 留空使用默认品牌；设为 szsx 等值可切换为对应的品牌资源与文案，
# 品牌图片放在 public/img/brand/<品牌>/ 下。
YANZHI_BRAND=

# ---------- 舞镜智练 / 舞安智护 子系统（可选）----------
# 独立启动时使用：npm run start:dance
# 数据目录默认沿用 YANZHI_DATA_DIR
DANCE_DATA_DIR=
# 设为 1 时访问根路径即进入舞蹈首页（单用姿态功能时开启）
DANCE_HOME=0
# 姿态解读与文本分析使用的模型配置 ID（留空则只用本地几何指标，
# 不产生任何模型调用与费用）
DANCE_VISION_PROVIDER_ID=
DANCE_TEXT_PROVIDER_ID=

# ---------- 部署账号（可选）----------
# 演示环境：自动生成 2 管理员、3 教师、6 学生、1 风险复核教师。
# 账号名固定，演示密码见 README-DANCE.md。请勿在公网生产环境开启。
DANCE_DEMO_MODE=0

# 正式部署如需首次启动自动建号，设为 1，并通过部署平台 Secret 注入下面密码。
# 密码至少 8 位，且同时包含字母与数字；已有账号不会被覆盖或重置。
DANCE_BOOTSTRAP_ACCOUNTS=0
DANCE_ADMIN_PASSWORD=
DANCE_TEACHER_PASSWORD=
DANCE_STUDENT_PASSWORD=
DANCE_MEDIC_PASSWORD=

# ---------- 千问视觉（可选）----------
# API Key 只能在运行时通过 Secret/环境变量注入，禁止写入仓库或镜像。
DASHSCOPE_API_KEY=
# 北京旧版公共域名仍可用；推荐换成百炼控制台显示的业务空间 API Host：
# https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen3-vl-plus
QWEN_CONCURRENCY=2
QWEN_TIMEOUT_MS=90000
QWEN_MAX_TOKENS=2000
